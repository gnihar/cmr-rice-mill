@page "/app/lots/{LotId:guid}/do"
@inject ApiClient Api
@inject LangState Lang
@inject NavigationManager Nav
@inject HttpClient Http

<h1>@Lang.H("सीएमआर जमा आदेश", "CMR deposit order")</h1>
<form class="card" data-testid="do-form" @onsubmit="Save" @onsubmit:preventDefault>
    <label>CDO</label><input data-testid="do-no" @bind="no" />
    <label>@Lang.H("तारीख", "Date")</label><input type="date" @bind="date" />
    <label>@Lang.H("गोदाम / गंतव्य", "Godown / destination")</label><input @bind="destination" />
    <label>@Lang.H("चावल (क्विंटल)", "Rice (qtl)")</label><input @bind="qty" inputmode="decimal" />
    <label>@Lang.H("ट्रक", "Truck")</label><input @bind="truck" />
    <label>@Lang.H("जारी केंद्र", "Issue centre")</label><input @bind="centre" />
    <label>@Lang.H("कागज़ पर छपा लॉट", "Printed lot number")</label><input @bind="printed" />
    <InputFile OnChange="e => file = e.File" accept="image/*,application/pdf" />
    @if (error is not null) { <p class="error">@error</p> }
    <button class="btn wide" type="submit">@Lang.H("सहेजें", "Save")</button>
</form>

@code {
    [Parameter] public Guid LotId { get; set; }
    private string no = "CDO", destination = "", qty = "", truck = "", centre = "", printed = "";
    private DateTime date = DateTime.Today;
    private string? error;
    private IBrowserFile? file;

    protected override async Task OnParametersSetAsync()
    {
        var lot = await Api.Get<LotDetailDto>($"api/lots/{LotId}");
        if (lot is null) return;
        truck = lot.TruckNo ?? ""; centre = lot.CentreName; printed = lot.LotNo;
        if (lot.Balance.RiceDueQtl is decimal due && string.IsNullOrEmpty(qty)) qty = due.ToString();
        if (lot.Do is not null) { no = lot.Do.DoNo; destination = lot.Do.Destination; qty = lot.Do.RiceQtyQtl.ToString(); date = lot.Do.DoDate.ToDateTime(TimeOnly.MinValue); }
    }

    private async Task Save()
    {
        error = null;
        try
        {
            var body = new DoWrite(no, DateOnly.FromDateTime(date), destination, decimal.Parse(qty), truck, null, null, null, null, null, centre, null, printed, null, Guid.NewGuid());
            var saved = await Api.SendJson<WriteResultDto>(HttpMethod.Put, $"api/lots/{LotId}/do", body);
            if (file is not null) await Uploader.Send(Http, file, "cmr_do", saved.Id);
            Nav.NavigateTo($"/app/lots/{LotId}");
        }
        catch (Exception ex) { error = ex.Message; }
    }
}
